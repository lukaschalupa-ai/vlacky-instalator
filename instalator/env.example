# Příklad nastavení. Průvodce (instalovat.sh / instalovat.cmd) si vytvoří vlastní soubor .env.
# Pozor: v hodnotách nepoužívej znaky $ " ' # \ ani zpětný apostrof.
APP_PASSWORD=sem-napis-dlouhe-heslo-aspon-8-znaku
VLACKY_PORT=8090
APP_NAME=Vláčky
VLACKY_DATA=./data
VLACKY_TZ=Europe/Prague
# HTTPS (volitelné): složka, kde leží fullchain.pem a privkey.pem
#VLACKY_CERT_DIR=/cesta/k/certifikatu
